<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %> · <%= config.negocio.nombre %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Source+Sans+3:wght@400;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/static/css/app.css" />
</head>
<body>
  <div class="shell">
    <header class="topbar">
      <button class="menu-toggle" type="button" id="menu-toggle" aria-controls="sidebar" aria-expanded="false">Menú</button>
      <a class="brand brand-compact" href="<%= user.rol === 'cajero' ? '/caja' : '/' %>">
        <%- include("mark") %>
        <strong class="wordmark"><%= config.negocio.nombre.endsWith("OS") ? config.negocio.nombre.slice(0, -2) : config.negocio.nombre %><% if (config.negocio.nombre.endsWith("OS")) { %><span>OS</span><% } %></strong>
      </a>
      <span class="topbar-role"><%= user.rolNombre %></span>
    </header>
    <div class="nav-backdrop" id="nav-backdrop" hidden></div>
    <aside class="sidebar" id="sidebar">
      <a class="brand" href="<%= user.rol === 'cajero' ? '/caja' : '/' %>">
        <%- include("mark") %>
        <span>
          <strong class="wordmark"><%= config.negocio.nombre.endsWith("OS") ? config.negocio.nombre.slice(0, -2) : config.negocio.nombre %><% if (config.negocio.nombre.endsWith("OS")) { %><span>OS</span><% } %></strong>
          <small><%= config.negocio.sucursal %></small>
        </span>
      </a>
      <p class="nav-label">Menú</p>
      <nav>
        <% if (user.rol !== 'cajero') { %><a href="/" class="<%= typeof nav !== 'undefined' && nav === 'inicio' ? 'active' : '' %>" title="Resumen del día">Inicio</a><% } %>
        <% if (can('caja')) { %><a href="/caja" class="<%= typeof nav !== 'undefined' && nav === 'caja' ? 'active' : '' %>" title="Cobrar productos">Caja</a><% } %>
        <% if (can('inventario')) { %><a href="/inventario" class="<%= typeof nav !== 'undefined' && nav === 'inventario' ? 'active' : '' %>" title="Existencias, precios y ajustes">Inventario</a><% } %>
        <% if (can('ventas')) { %><a href="/ventas" class="<%= typeof nav !== 'undefined' && nav === 'ventas' ? 'active' : '' %>" title="Historial de tickets">Ventas</a><% } %>
        <% if (can('asistente')) { %><a href="/asistente" class="<%= typeof nav !== 'undefined' && nav === 'asistente' ? 'active' : '' %>" title="Preguntas, stock y totales">Asistente</a><% } %>
        <% if (can('usuarios')) { %><a href="/usuarios" class="<%= typeof nav !== 'undefined' && nav === 'usuarios' ? 'active' : '' %>" title="Cuentas del equipo">Usuarios</a><% } %>
      </nav>
      <form class="sidebar-user" method="post" action="/logout">
        <div>
          <strong><%= user.nombre %></strong>
          <small><%= user.rolNombre %><% if (user.rol === "superusuario") { %> · desarrollador<% } %></small>
        </div>
        <button type="submit">Salir</button>
      </form>
    </aside>
    <main class="main">
      <% if (flash) { %>
        <div class="flash <%= flash.tipo %>" role="status"><%= flash.texto %></div>
      <% } %>
