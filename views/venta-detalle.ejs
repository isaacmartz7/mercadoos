<%- include("partials/header") %>
<div class="preview-chrome">
  <header class="page-head">
    <div>
      <p class="eyebrow"><%= venta.estado === "devolucion" ? "Devolución" : "Vista previa" %></p>
      <h1><%= venta.estado === "devolucion" ? "Devolución" : "Ticket" %> #<%= venta.id %></h1>
      <p class="lede"><%= venta.estado === "devolucion" ? "Comprobante de la devolución. Revisa el recibo y, cuando esté bien, pulsa Imprimir." : "Así saldrá en el papel. Revisa el recibo y, cuando esté bien, pulsa Imprimir." %></p>
    </div>
    <div class="actions">
      <button class="btn primary" type="button" onclick="window.print()">Imprimir</button>
      <% if (can('caja')) { %><a class="btn" href="/caja">Volver a caja</a><% } %>
      <a class="btn" href="/ventas">Volver a ventas</a>
    </div>
  </header>
  <% if (venta.estado === 'completada' && can('anular')) { %>
    <form class="preview-anular" method="post" action="/ventas/<%= venta.id %>/anular" onsubmit="return confirm('¿Anular y devolver el stock?');">
      <button class="btn danger" type="submit">Anular venta</button>
    </form>
  <% } %>
</div>

<div class="preview-stage">
  <article class="ticket-paper" aria-label="Vista previa del ticket">
    <header class="ticket-paper-head">
      <p class="store"><%= config.negocio.nombre %></p>
      <p class="branch"><%= config.negocio.sucursal %></p>
      <p class="meta"><%= venta.estado === "devolucion" ? "Devolución" : "Ticket" %> #<%= venta.id %></p>
      <p class="meta"><%= venta.fecha %></p>
      <p class="meta">Cajero: <%= venta.cajero %></p>
      <p class="meta"><%= venta.estado === "anulada" ? "Anulada" : venta.estado === "devolucion" ? "Devolución" : "Completada" %></p>
    </header>

    <ul class="ticket-lines">
      <% detalle.forEach(function (d) { %>
        <li>
          <p class="line-name"><%= d.nombre %></p>
          <p class="line-detail">
            <span><%= money(d.cantidad) %> <%= d.unidad %> × <%= config.negocio.moneda %> <%= money(d.precio_unitario) %></span>
            <strong><%= config.negocio.moneda %> <%= money(d.subtotal) %></strong>
          </p>
          <% if (d.codigo_barras) { %><p class="line-code"><%= d.codigo_barras %></p><% } %>
        </li>
      <% }) %>
    </ul>

    <dl class="ticket-totals">
      <div><dt>Subtotal</dt><dd><%= config.negocio.moneda %> <%= money(venta.subtotal) %></dd></div>
      <div><dt>ISV</dt><dd><%= config.negocio.moneda %> <%= money(venta.impuesto) %></dd></div>
      <div><dt>Descuento</dt><dd><%= config.negocio.moneda %> <%= money(venta.descuento) %></dd></div>
      <div class="grand"><dt><%= venta.estado === "devolucion" ? "Total devuelto" : "Total" %></dt><dd><%= config.negocio.moneda %> <%= money(venta.total) %></dd></div>
    </dl>

    <dl class="ticket-pay">
      <div><dt>Pago</dt><dd><%= venta.metodo_pago === "tarjeta" ? "Tarjeta" : "Efectivo" %></dd></div>
      <% if (venta.estado === "devolucion") { %>
        <div><dt>Entregado al cliente</dt><dd><%= config.negocio.moneda %> <%= money(venta.recibido) %></dd></div>
      <% } else { %>
        <div><dt>Recibido</dt><dd><%= config.negocio.moneda %> <%= money(venta.recibido) %></dd></div>
        <div><dt>Cambio</dt><dd><%= config.negocio.moneda %> <%= money(venta.cambio) %></dd></div>
      <% } %>
    </dl>

    <p class="ticket-thanks"><%= venta.estado === "devolucion" ? "Devolución registrada" : "Gracias por su compra" %></p>
  </article>
</div>
<%- include("partials/footer") %>
