<%- include("partials/header") %>
<header class="page-head">
  <div>
    <p class="eyebrow">Administración</p>
    <h1>Usuarios</h1>
    <p class="lede">Cada persona entra con su usuario. El rol decide si puede cobrar, editar productos o ver reportes.</p>
  </div>
</header>

<form class="panel form-inline" method="post" action="/usuarios">
  <p class="hint form-intro">La contraseña debe tener al menos 8 caracteres. No se vuelve a mostrar después de crear la cuenta.</p>
  <label>Nombre completo <input name="nombre" required placeholder="Nombre y apellido" /></label>
  <label>Usuario <input name="usuario" required placeholder="sin espacios" autocomplete="off" /></label>
  <label>Contraseña <input name="password" type="password" minlength="8" autocomplete="new-password" required /></label>
  <label>Rol
    <select name="rol_id">
      <% roles.forEach(function (r) { %>
        <option value="<%= r.id %>"><%= r.nombre %></option>
      <% }) %>
    </select>
  </label>
  <button class="btn primary" type="submit">Crear usuario</button>
</form>

<section class="panel">
  <% if (!usuarios.length) { %>
    <div class="empty"><p>No hay usuarios para mostrar.</p></div>
  <% } else { %>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Nombre</th><th>Usuario</th><th>Rol</th><th>Estado</th></tr></thead>
        <tbody>
          <% usuarios.forEach(function (u) { %>
            <tr>
              <td><%= u.nombre %></td>
              <td><%= u.usuario %></td>
              <td><%= u.rol %><% if (u.rol_clave === "superusuario") { %> <span class="role-badge">dev</span><% } %></td>
              <td><%= u.activo ? "Activo" : "Inactivo" %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>
<%- include("partials/footer") %>
