<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %> · <%= config.negocio.nombre %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,700&family=Source+Sans+3:wght@400;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/static/css/app.css" />
</head>
<body class="login-body">
  <main class="login-card">
    <p class="eyebrow">Sistema de supermercado</p>
    <h1>MercadoOS</h1>
    <p class="muted">Entra con tu usuario. La contraseña queda oculta al escribir.</p>
    <% if (error) { %><div class="flash error"><%= error %></div><% } %>
    <form method="post" action="/login" autocomplete="on">
      <label>Usuario
        <input name="usuario" autocomplete="username" spellcheck="false" autocapitalize="off" required autofocus />
      </label>
      <label>Contraseña
        <span class="password-field">
          <input id="login-password" name="password" type="password" autocomplete="current-password" spellcheck="false" required />
          <button class="password-toggle" type="button" id="toggle-password" aria-label="Mostrar contraseña" aria-pressed="false" title="Mostrar contraseña">
            <svg class="icon-eye" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M2.2 12s3.6-7 9.8-7 9.8 7 9.8 7-3.6 7-9.8 7-9.8-7-9.8-7z"/>
              <circle cx="12" cy="12" r="3"/>
            </svg>
            <svg class="icon-eye-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 3l18 18"/>
              <path d="M10.6 10.6A3 3 0 0 0 12 15a3 3 0 0 0 2.4-4.4"/>
              <path d="M9.9 5.2A11 11 0 0 1 12 5c6.2 0 9.8 7 9.8 7a18 18 0 0 1-3.2 3.9"/>
              <path d="M6.5 6.5C4.1 8.2 2.2 12 2.2 12S5.8 19 12 19c1.3 0 2.5-.3 3.6-.8"/>
            </svg>
          </button>
        </span>
      </label>
      <button class="btn primary" type="submit">Entrar</button>
    </form>
    <p class="login-hint">La contraseña se oculta al escribir. Usa el ojo si necesitas verla.</p>
  </main>
  <script>
    (function () {
      var input = document.getElementById("login-password");
      var btn = document.getElementById("toggle-password");
      if (!input || !btn) return;
      btn.addEventListener("click", function () {
        var show = input.type === "password";
        input.type = show ? "text" : "password";
        btn.setAttribute("aria-pressed", show ? "true" : "false");
        btn.setAttribute("aria-label", show ? "Ocultar contraseña" : "Mostrar contraseña");
        btn.setAttribute("title", show ? "Ocultar contraseña" : "Mostrar contraseña");
        input.focus();
      });
    })();
  </script>
</body>
</html>
