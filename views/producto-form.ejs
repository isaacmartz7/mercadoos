<%- include("partials/header") %>
<header class="page-head">
  <div>
    <p class="eyebrow">Inventario</p>
    <h1>Editar producto</h1>
    <p class="lede">Corrige nombre, precio, código, impuesto o si sigue activo. El stock se ajusta en Inventario. Un producto nuevo se crea en Caja.</p>
  </div>
  <a class="btn" href="/inventario">Volver a inventario</a>
</header>

<form class="panel form-grid" method="post">
  <label>Código de barras
    <input name="codigo_barras" required placeholder="Ej. 7501000100019" value="<%= producto ? producto.codigo_barras : '' %>" />
  </label>
  <label>Nombre
    <input name="nombre" required placeholder="Ej. Arroz blanco 5 lb" value="<%= producto ? producto.nombre : '' %>" />
  </label>
  <label>Categoría
    <select name="categoria_id">
      <% categorias.forEach(function (c) { %>
        <option value="<%= c.id %>" <%= producto && producto.categoria_id === c.id ? "selected" : "" %>><%= c.nombre %></option>
      <% }) %>
    </select>
  </label>
  <label>Unidad
    <select name="unidad">
      <% ["unidad", "lb", "kg", "litro"].forEach(function (u) { %>
        <option value="<%= u %>" <%= producto && producto.unidad === u ? "selected" : "" %>><%= u %></option>
      <% }) %>
    </select>
  </label>
  <label>Precio de venta (<%= config.negocio.moneda %>)
    <input name="precio_venta" type="number" step="0.01" min="0" required placeholder="0.00" value="<%= producto ? producto.precio_venta : '' %>" />
  </label>
  <label>Costo (<%= config.negocio.moneda %>)
    <input name="costo" type="number" step="0.01" min="0" value="<%= producto ? producto.costo : 0 %>" />
  </label>
  <label>Impuesto ISV
    <input name="impuesto" type="number" step="0.01" min="0" value="<%= producto ? producto.impuesto : config.negocio.impuestoDefault %>" />
    <small class="field-help">Usa 0.15 para 15%.</small>
  </label>
  <% if (!producto) { %>
    <label>Stock inicial
      <input name="stock" type="number" step="0.01" min="0" value="0" />
    </label>
  <% } %>
  <label>Stock mínimo
    <input name="stock_minimo" type="number" step="0.01" min="0" value="<%= producto ? producto.stock_minimo : 5 %>" />
    <small class="field-help">Si el stock baja de este número, se marca en amarillo.</small>
  </label>
  <label class="check">
    <input type="checkbox" name="activo" value="1" <%= !producto || producto.activo ? "checked" : "" %> />
    Activo en caja
  </label>
  <div class="form-actions">
    <button class="btn primary" type="submit"><%= producto ? "Guardar cambios" : "Crear producto" %></button>
  </div>
</form>
<%- include("partials/footer") %>
