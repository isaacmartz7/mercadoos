<%- include("partials/header") %>
<header class="page-head">
  <div>
    <p class="eyebrow">Catálogo</p>
    <h1><%= producto ? "Editar producto" : "Nuevo producto" %></h1>
  </div>
  <a class="btn" href="/productos">Volver</a>
</header>

<form class="panel form-grid" method="post">
  <label>Código de barras
    <input name="codigo_barras" required value="<%= producto ? producto.codigo_barras : '' %>" />
  </label>
  <label>Nombre
    <input name="nombre" required value="<%= producto ? producto.nombre : '' %>" />
  </label>
  <label>Categoría
    <select name="categoria_id">
      <% categorias.forEach(function (c) { %>
        <option value="<%= c.id %>" <%= producto && producto.categoria_id === c.id ? "selected" : "" %>><%= c.nombre %></option>
      <% }) %>
    </select>
  </label>
  <label>Unidad
    <select name="unidad">
      <% ["unidad", "lb", "kg", "litro"].forEach(function (u) { %>
        <option value="<%= u %>" <%= producto && producto.unidad === u ? "selected" : "" %>><%= u %></option>
      <% }) %>
    </select>
  </label>
  <label>Precio de venta
    <input name="precio_venta" type="number" step="0.01" min="0" required value="<%= producto ? producto.precio_venta : '' %>" />
  </label>
  <label>Costo
    <input name="costo" type="number" step="0.01" min="0" value="<%= producto ? producto.costo : 0 %>" />
  </label>
  <label>Impuesto (ISV)
    <input name="impuesto" type="number" step="0.01" min="0" value="<%= producto ? producto.impuesto : config.negocio.impuestoDefault %>" />
  </label>
  <% if (!producto) { %>
    <label>Stock inicial
      <input name="stock" type="number" step="0.01" min="0" value="0" />
    </label>
  <% } %>
  <label>Stock mínimo
    <input name="stock_minimo" type="number" step="0.01" min="0" value="<%= producto ? producto.stock_minimo : 5 %>" />
  </label>
  <div class="form-actions">
    <button class="btn primary" type="submit">Guardar</button>
  </div>
</form>
<%- include("partials/footer") %>
