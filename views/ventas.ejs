<%- include("partials/header") %>
<header class="page-head">
  <div>
    <p class="eyebrow">Historial</p>
    <h1>Ventas</h1>
    <p class="lede"><%= user.rol === "cajero" ? "Aquí ves solo los tickets que cobraste." : "Historial reciente de tickets. Entra a uno para imprimirlo o anularlo si tienes permiso." %></p>
  </div>
  <% if (can('caja')) { %>
    <a class="btn primary" href="/caja">Nueva venta</a>
  <% } %>
</header>
<section class="panel">
  <% if (!ventas.length) { %>
    <div class="empty">
      <p>No hay ventas registradas todavía.</p>
      <% if (can('caja')) { %><p><a href="/caja">Cobra la primera en caja</a>.</p><% } %>
    </div>
  <% } else { %>
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th>#</th><th>Fecha</th><th>Cajero</th><th>Total</th><th>Pago</th><th>Estado</th><th></th></tr>
        </thead>
        <tbody>
          <% ventas.forEach(function (v) { %>
            <tr>
              <td><%= v.id %></td>
              <td><%= v.fecha %></td>
              <td><%= v.cajero %></td>
              <td><%= v.estado === "devolucion" ? "− " : "" %><%= config.negocio.moneda %> <%= money(v.total) %></td>
              <td><%= v.metodo_pago === "tarjeta" ? "Tarjeta" : "Efectivo" %></td>
              <td>
                <% if (v.estado === "devolucion") { %><span class="tag return">Devolución</span>
                <% } else if (v.estado === "anulada") { %><span class="tag void">Anulada</span>
                <% } else { %>Completada<% } %>
              </td>
              <td><a href="/ventas/<%= v.id %>">Ver ticket</a></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>
<%- include("partials/footer") %>
