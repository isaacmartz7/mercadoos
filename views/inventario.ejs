<%- include("partials/header") %>
<header class="page-head">
  <div>
    <p class="eyebrow">Bodega</p>
    <h1>Inventario</h1>
    <p class="lede">Aquí está cada producto registrado. Las filas en amarillo están en o bajo el mínimo. Corrige nombre, precio o código con Editar. El alta de un producto nuevo se hace en Caja.</p>
  </div>
</header>

<% if (puedeAjustar) { %>
<form id="ajuste-form" class="panel ajuste-form" method="post" action="/inventario/ajuste">
  <p class="hint form-intro">Para entrar mercadería usa un número positivo. Para salida o merma usa un número negativo. Escribe el producto y elígelo de la lista.</p>
  <div class="ajuste-pick">
    <label>Producto
      <input id="ajuste-buscar" type="text" placeholder="Escribe el nombre o el código..." autocomplete="off" />
    </label>
    <div id="ajuste-resultados" class="results"></div>
    <p id="ajuste-elegido" class="hint"></p>
    <input type="hidden" name="producto_id" id="ajuste-id" />
  </div>
  <div class="form-inline">
    <label>Cantidad
      <input name="cantidad" type="number" step="0.01" required placeholder="+10 o -2" />
    </label>
    <label>Motivo
      <input name="motivo" placeholder="Recepción, conteo, merma..." required />
    </label>
    <button class="btn primary" type="submit">Registrar ajuste</button>
  </div>
</form>
<script>
  window.PRODUCTOS_AJUSTE = <%- JSON.stringify(productos.map(function (p) {
    return { id: p.id, nombre: p.nombre, codigo_barras: p.codigo_barras, stock: p.stock, unidad: p.unidad };
  })).replace(/</g, "\\u003c") %>;
</script>
<script src="/static/js/inventario.js"></script>
<% } else { %>
  <p class="hint">Puedes consultar existencias. Solo bodega o administración registra ajustes.</p>
<% } %>

<div class="split">
  <section class="panel">
    <h2>Existencias</h2>
    <% if (!productos.length) { %>
      <div class="empty"><p>No hay productos para mostrar.</p></div>
    <% } else { %>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Producto</th><th>Precio</th><th>Stock</th><th>Mínimo</th><th></th></tr></thead>
          <tbody>
            <% productos.forEach(function (p) { %>
              <tr class="<%= p.stock <= p.stock_minimo ? 'row-warn' : '' %> <%= p.activo ? '' : 'row-off' %>">
                <td>
                  <%= p.nombre %>
                  <% if (!p.activo) { %><small class="muted">Inactivo</small><% } %>
                </td>
                <td><%= config.negocio.moneda %> <%= money(p.precio_venta) %></td>
                <td><%= money(p.stock) %> <%= p.unidad %></td>
                <td><%= money(p.stock_minimo) %></td>
                <td><% if (can('productos')) { %><a href="/productos/<%= p.id %>/editar">Editar</a><% } %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>
  <section class="panel">
    <h2>Kardex reciente</h2>
    <% if (!movimientos.length) { %>
      <div class="empty"><p>Aún no hay movimientos registrados.</p></div>
    <% } else { %>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Fecha</th><th>Producto</th><th>Tipo</th><th>Cant.</th><th>Nuevo</th></tr></thead>
          <tbody>
            <% movimientos.forEach(function (m) { %>
              <tr>
                <td><%= m.fecha %></td>
                <td><%= m.producto %></td>
                <td><%= m.tipo %></td>
                <td><%= money(m.cantidad) %></td>
                <td><%= money(m.stock_nuevo) %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>
</div>
<%- include("partials/footer") %>
