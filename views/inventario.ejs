<%- include("partials/header") %>
<header class="page-head">
  <div>
    <p class="eyebrow">Bodega</p>
    <h1>Inventario</h1>
    <p class="lede">Las filas en amarillo están en o bajo el mínimo. El kardex muestra los últimos movimientos.</p>
  </div>
</header>

<% if (puedeAjustar) { %>
<form class="panel form-inline" method="post" action="/inventario/ajuste">
  <p class="hint form-intro">Para entrar mercadería usa un número positivo. Para salida o merma usa un número negativo.</p>
  <label>Producto
    <select name="producto_id" required>
      <% productos.forEach(function (p) { %>
        <option value="<%= p.id %>"><%= p.nombre %> (hay <%= money(p.stock) %>)</option>
      <% }) %>
    </select>
  </label>
  <label>Cantidad
    <input name="cantidad" type="number" step="0.01" required placeholder="+10 o -2" />
  </label>
  <label>Motivo
    <input name="motivo" placeholder="Recepción, conteo, merma..." required />
  </label>
  <button class="btn primary" type="submit">Registrar ajuste</button>
</form>
<% } else { %>
  <p class="hint">Puedes consultar existencias. Solo bodega o administración registra ajustes.</p>
<% } %>

<div class="split">
  <section class="panel">
    <h2>Existencias</h2>
    <% if (!productos.length) { %>
      <div class="empty"><p>No hay productos para mostrar.</p></div>
    <% } else { %>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Producto</th><th>Stock</th><th>Mínimo</th></tr></thead>
          <tbody>
            <% productos.forEach(function (p) { %>
              <tr class="<%= p.stock <= p.stock_minimo ? 'row-warn' : '' %>">
                <td><%= p.nombre %></td>
                <td><%= money(p.stock) %> <%= p.unidad %></td>
                <td><%= money(p.stock_minimo) %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>
  <section class="panel">
    <h2>Kardex reciente</h2>
    <% if (!movimientos.length) { %>
      <div class="empty"><p>Aún no hay movimientos registrados.</p></div>
    <% } else { %>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Fecha</th><th>Producto</th><th>Tipo</th><th>Cant.</th><th>Nuevo</th></tr></thead>
          <tbody>
            <% movimientos.forEach(function (m) { %>
              <tr>
                <td><%= m.fecha %></td>
                <td><%= m.producto %></td>
                <td><%= m.tipo %></td>
                <td><%= money(m.cantidad) %></td>
                <td><%= money(m.stock_nuevo) %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>
</div>
<%- include("partials/footer") %>
