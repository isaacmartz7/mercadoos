<%- include("partials/header") %>
<header class="page-head">
  <div>
    <p class="eyebrow">Gerencia</p>
    <h1>Reportes</h1>
    <p class="lede">Totales del día, margen aproximado, productos quietos y el CSV para cuadrar.</p>
  </div>
  <a class="btn" href="/reportes/csv">Descargar CSV</a>
</header>

<section class="stats">
  <article class="stat">
    <span>Hoy</span>
    <strong><%= config.negocio.moneda %> <%= money(hoy.total) %></strong>
    <small><%= hoy.n === 1 ? "1 venta" : hoy.n + " ventas" %></small>
  </article>
  <article class="stat">
    <span>Últimos 7 días</span>
    <strong><%= config.negocio.moneda %> <%= money(semana.total) %></strong>
    <small><%= semana.n === 1 ? "1 venta" : semana.n + " ventas" %></small>
  </article>
  <article class="stat">
    <span>Margen de hoy</span>
    <strong><%= config.negocio.moneda %> <%= money(margen) %></strong>
    <small>Venta menos costo, ya restando descuentos</small>
  </article>
</section>

<div class="split">
  <section class="panel">
    <h2>Por cajero (hoy)</h2>
    <% if (!porCajero.length) { %>
      <div class="empty"><p>Hoy nadie ha cobrado todavía.</p></div>
    <% } else { %>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Cajero</th><th>Tickets</th><th>Total</th></tr></thead>
          <tbody>
            <% porCajero.forEach(function (r) { %>
              <tr>
                <td><%= r.nombre %></td>
                <td><%= r.n %></td>
                <td><%= config.negocio.moneda %> <%= money(r.total) %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>
  <section class="panel">
    <h2>Más vendidos (7 días)</h2>
    <% if (!masVendidos.length) { %>
      <div class="empty"><p>Aún no hay ventas en la última semana.</p></div>
    <% } else { %>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Producto</th><th>Cant.</th><th>Total</th></tr></thead>
          <tbody>
            <% masVendidos.forEach(function (r) { %>
              <tr>
                <td><%= r.nombre %></td>
                <td><%= money(r.cantidad) %></td>
                <td><%= config.negocio.moneda %> <%= money(r.total) %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>
</div>

<section class="panel">
  <h2>Sin movimiento (30 días)</h2>
  <% if (!sinMovimientoN) { %>
    <p class="muted">Todos los productos activos se vendieron en el último mes.</p>
  <% } else { %>
    <p class="hint"><%= sinMovimientoN === 1 ? "1 producto activo" : sinMovimientoN + " productos activos" %> sin ventas en los últimos 30 días.</p>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Producto</th><th>Stock</th></tr></thead>
        <tbody>
          <% sinMovimiento.forEach(function (p) { %>
            <tr>
              <td><%= p.nombre %></td>
              <td><%= money(p.stock) %> <%= p.unidad %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<section class="panel">
  <h2>Stock bajo</h2>
  <% if (!stockBajo.length) { %>
    <p class="muted">Ningún producto está bajo el mínimo. Bien.</p>
  <% } else { %>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Producto</th><th>Categoría</th><th>Stock</th><th>Mínimo</th></tr></thead>
        <tbody>
          <% stockBajo.forEach(function (p) { %>
            <tr class="row-warn">
              <td><%= p.nombre %></td>
              <td><%= p.categoria || "—" %></td>
              <td><%= money(p.stock) %></td>
              <td><%= money(p.stock_minimo) %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>
<%- include("partials/footer") %>
